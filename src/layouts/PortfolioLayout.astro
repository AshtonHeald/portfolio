---
import BaseLayout from "../layouts/BaseLayout.astro";
import Theme from "../components/Theme.vue";
import Sidebar from "../components/nav/Sidebar.astro";
import Navbar from "../components/nav/Navbar.astro";
import { Toaster } from "@/components/ui/sonner";
import "@/styles/global.css";
import "@fontsource-variable/inter";
import { cn } from "@/lib/utils";
---

<BaseLayout pageTitle="Ashton G. Heald - Developer Portfolio">
  <div
    class={cn(
      "xl:absolute inset-0",
      "[background-size:32px_32px]",
      "[background-image:linear-gradient(to_right,#e4e4e7_1px,transparent_1px),linear-gradient(to_bottom,#e4e4e7_1px,transparent_1px)]",
      "dark:[background-image:linear-gradient(to_right,#262626_1px,transparent_1px),linear-gradient(to_bottom,#262626_1px,transparent_1px)]",
    )}
  >
  </div>
  {/* Radial gradient for the container to give a faded look */}
  <div
    class="pointer-events-none absolute inset-0 hidden items-center justify-center bg-white [mask-image:radial-gradient(ellipse_at_center,transparent_75%,black)] xl:flex dark:bg-black"
  >
  </div>
  <!-- h-[calc(100dvh-60px)] -->
  <div
    class="browser-box bg-background absolute h-[calc(100dvh-52px)] w-full xl:h-[675px] xl:max-w-[1200px] xl:rounded-sm xl:border"
  >
    <div
      class="browser-toolbar bg-background fixed top-0 z-10 inline-flex h-[52px] w-full items-center justify-between rounded-t-sm border-b px-2 xl:relative xl:top-auto xl:border-0 xl:pl-0"
    >
      <div class="xl:hidden">
        <Navbar />
      </div>
      <Theme client:only />
    </div>
    <div class="hidden xl:block">
      <Sidebar />
    </div>
    <div class="border-base-300 h-full xl:h-auto xl:border-t">
      <main
        class="[&::-webkit-scrollbar-thumb]:[--border] mt-13 h-full w-full overflow-y-auto xl:mt-0 xl:ml-64 xl:h-[620px] xl:w-[calc(100%-256px)] [&::-webkit-scrollbar]:w-3 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:border-4 [&::-webkit-scrollbar-thumb]:border-transparent [&::-webkit-scrollbar-thumb]:bg-[var(--border)] [&::-webkit-scrollbar-thumb]:bg-clip-content [&::-webkit-scrollbar-track]:rounded-full"
      >
        <slot />
      </main>
    </div>
  </div>
  <Toaster client:load />
</BaseLayout>
