---
import "@/styles/global.css";

import "@fontsource-variable/inter";
import "@fontsource-variable/playfair-display";

const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="preload" as="image" href="/images/okc-map-light.webp" />
    <link rel="preload" as="image" href="/images/okc-map-dark.webp" />
    <script is:inline>
      // Prevent FART effect
      if (localStorage.getItem("theme") === null) {
        document.documentElement.classList.add("light");
      } else {
        document.documentElement.classList.add(localStorage.getItem("theme"));
      }
    </script>
    <script>
      import { themeChange } from "theme-change";
      themeChange();
      // 👆 you could import the CDN directly instead of these two lines
    </script>
  </head>
  <body
    class="max-auto max-w-full font-sans xl:grid xl:h-screen xl:place-items-center xl:overflow-hidden"
  >
    <slot />
  </body>
</html>
<style is:global>
  html * {
    scroll-behavior: smooth;
  }

  #home {
    display: grid;
    place-items: center;
  }

  h1,
	h2,
	h3,
	/*
	h4 {
		@apply font-serif;
		font-weight: 600;
	}
		*/
	h5,
	h6 {
    font-weight: 600;
  }

  @media (min-width: 1280px) {
    .browser-box .browser-toolbar:before {
      content: "";
      aspect-ratio: 1 / 1;
      height: 0.75rem;
      border-radius: 9999px;
      opacity: 0.3;
      box-shadow:
        1.4em 0,
        2.8em 0,
        4.2em 0;
    }
  }
</style>
