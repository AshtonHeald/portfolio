---
import * as content from "@/content/sections/contact.md";
import { buttonVariants } from "@/components/ui/button";
import { Github, Linkedin, Twitter, Mail } from "@lucide/astro";
import Form from "@/components/Form.vue";
---

<div
  class="mx-auto flex max-w-[500px] flex-col gap-6 lg:max-w-full lg:flex-row"
>
  <div
    class="flex flex-col items-center gap-2 lg:w-6/12 lg:items-start lg:gap-4"
  >
    <div class="flex flex-col items-center lg:items-start">
      <h4 class="font-sans font-bold">Contact Information</h4>
      <p class="mb-3 text-center text-sm lg:text-left">
        Feel free to reach out to me directly or through the form. I'll get back
        to you as soon as possible.
      </p>
      <a
        href=""
        class={`${buttonVariants({ variant: "default" })} rounded-xs align-items-end mb-3`}
      >
        <Mail />
        <span> contact@ashtonheald.me </span>
      </a>
    </div>
    <div>
      <h4 class="mb-2 font-sans font-bold">Connect With Me</h4>
      <div class="flex gap-3">
        <a href="" class={`${buttonVariants({ size: "icon" })} rounded-xs`}>
          <Github />
        </a>
        <a href="" class={`${buttonVariants({ size: "icon" })} rounded-xs`}>
          <Linkedin />
        </a>
        <a href="" class={`${buttonVariants({ size: "icon" })} rounded-xs`}>
          <Twitter />
        </a>
      </div>
    </div>
  </div>
  <div class="lg:w-6/12">
    <Form client:load />
  </div>
</div>

<style is:global>
  @media (width >= 80rem) {
    :root #contact {
      background-image: url("/images/okc-map-light.webp");
    }
    .dark #contact {
      background-image: url("/images/okc-map-dark.webp");
    }
    #contact {
      background-size: cover;
      background-position: center;
    }
    #contact * {
      z-index: 2;
    }
    #contact::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      opacity: 0.9;
      background-color: var(--background);
      border-bottom-right-radius: var(--radius-md);
    }
  }
</style>
