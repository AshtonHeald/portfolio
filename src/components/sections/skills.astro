---
import * as content from "@/content/sections/skills.md";
import { getCollection } from "astro:content";

import SkillCard from "@/components/SkillCard.vue";

const skills = (await getCollection("skills")).sort((a, b) =>
  a.id.localeCompare(b.id),
);

const fallbackIcon = content.frontmatter.icon || "";
---

<div class="grid grid-cols-3 grid-rows-3 gap-4">
  {
    skills.map((skill, index) => (
      <SkillCard
        client:visible
        id={skill.id}
        title={skill.data.title}
        description={skill.data.description}
        icon={skill.data.icon || fallbackIcon}
        isFeatured={index === 2}
        concepts={skill.data.concepts}
      />
    ))
  }
</div>
