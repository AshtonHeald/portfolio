---
import NavMenu from "@/components/nav/NavMenu.vue";
---

<div
  id="navigation"
  class="border-base-300 bg-base-100 top-[53px] hidden w-64 border-r xl:absolute xl:block xl:h-[620px]"
>
  <div id="nav-header" class="flex flex-col text-center">
    <a
      href="https://ashthe.dev"
      aria-label="Visit Ash's website"
      id="avatar"
      class="border-base-300 hover:border-primary focus:border-primary mx-auto mt-8 mb-4 h-28 w-28 rounded-full border-[5px] bg-[url('/ash.webp')] bg-[length:115px_110px] bg-center transition-all hover:bg-[url('/ash-hover.webp')] focus-visible:outline-none"
    ></a>
    <span class="font-bold">Front-End Developer</span>
    <div class="mt-0.5 mb-2">@ashtonheald</div>

    <span id="status-line" class="mx-auto mt-1 mb-3 border-t"></span>
  </div>
  <NavMenu />
</div>

<style>
  #status {
    display: flex;
    flex-direction: column;
  }
  #status-line {
    content: "";

    width: 160px;
  }
</style>
