---
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import About from "@/components/sections/About.astro";
import Skills from "@/components/sections/Skills.astro";
import Projects from "@/components/sections/Projects.astro";
import Contact from "@/components/sections/Contact.astro";

import * as content from "@/content/sections.md";
import TypeWriter from "@/components/TypeWriter.jsx";

const textSequence = content.frontmatter.typewriterStrings
  .map((text: string) => [text, 3000])
  .flat();

// Define sections with their names and components
const sections = [
  { name: "Home", description: "Welcome to my portfolio", component: Home },
  { name: "About", description: "Get to know me", component: About },
  { name: "Skills", description: "Check out my expertise", component: Skills },
  {
    name: "Projects",
    description: "Showcasing my best work",
    component: Projects,
  },
  { name: "Contact", description: "Let's get in touch", component: Contact },
];
---

<PortfolioLayout pageTitle="Ashton G. Heald - Portfolio">
  <div class="z-10 mb-32 grid place-items-center text-center">
    <h1
      class="mb-2 text-center font-serif text-[2.5rem] !font-black md:mb-8 md:text-6xl lg:mb-8 lg:text-7xl"
    >
      <span class="name">Ash</span>ton G. Heald
    </h1>
    <span
      class="flex gap-1.5 text-center !font-serif text-[1.5rem] font-bold md:text-3xl lg:text-4xl"
    >
      <span> I'm a </span>
      <span class="bg-primary text-secondary">
        <TypeWriter textSequence={textSequence} client:load />
      </span>
    </span>
  </div>
  {
    sections.map(({ name, description, component: Section }, index) => (
      <section
        id={name.toLowerCase()}
        class="relative flex min-h-full flex-col p-4 md:p-8"
      >
        {index !== 0 && <h2 class="font-serif text-4xl font-bold">{name}</h2>}
        {index !== 0 && (
          <h3 class="mb-4 font-serif text-xl font-semibold">{description}</h3>
        )}
        <Section />
      </section>
    ))
  }
</PortfolioLayout>
