---
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import Home from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import Skills from "@/components/sections/Skills.astro";
import Projects from "@/components/sections/Projects.astro";
import Contact from "@/components/sections/Contact.astro";

// Define sections with their names and components
const sections = [
  { name: "Home", description: "Welcome to my portfolio", component: Home },
  { name: "About", description: "Get to know me", component: About },
  { name: "Skills", description: "Check out my expertise", component: Skills },
  {
    name: "Projects",
    description: "Showcasing my best work",
    component: Projects,
  },
  { name: "Contact", description: "Let's get in touch", component: Contact },
];
---

<PortfolioLayout pageTitle="Ashton G. Heald - Portfolio">
  {
    sections.map(({ name, description, component: Section }, index) => (
      <section
        id={name.toLowerCase()}
        class={`relative flex xl:min-h-full ${index === 0 ? "min-h-full" : ""} p-4 md:p-8 ${index !== 0 ? "!pb-12 md:!pb-24 xl:!pb-8" : ""} mx-auto w-full max-w-[872px] flex-col xl:mx-0 xl:max-w-full`}
      >
        {index !== 0 && (
          <h2 class="text-center font-serif text-3xl font-bold lg:text-4xl xl:text-left">
            {name}
          </h2>
        )}
        {index !== 0 && (
          <h3 class="mb-4 text-center font-serif text-lg font-semibold lg:text-xl xl:text-left">
            {description}
          </h3>
        )}
        <Section />
      </section>
    ))
  }
</PortfolioLayout>
